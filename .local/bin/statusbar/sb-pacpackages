#!/bin/sh

# Displays number of upgradeable packages.
# For this to work, have an `apt-get update` command run in the background as
# a cronjob every so often (see the `checkup` script in ~/.local/bin/cron).
# This script will then count the pending upgrades. When clicked, it will run
# an upgrade via apt.
#
# DARBS installs /etc/apt/apt.conf.d/99darbs-statusbar, which makes apt
# refresh this module after every package transaction:
#
# DPkg::Post-Invoke { "pkill -RTMIN+8 dwmblocks || true"; };

case $BLOCK_BUTTON in
	1) setsid -f "$TERMINAL" -e sb-popupgrade ;;
	2) notify-send "$(apt list --upgradable 2>/dev/null | sed 1d)" ;;
	3) notify-send "🎁 Upgrade module" "📦: number of upgradable packages
- Left click to upgrade packages
- Middle click to show upgradable packages" ;;
	6) setsid -f "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

apt-get -s upgrade 2>/dev/null | grep -c "^Inst " | sed "s/^/📦/;s/^📦0$//g"
